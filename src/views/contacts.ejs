<%- include('partials/head', { title: 'Contacts', active: 'contacts' }) %>
<%
  function consentPill(s){
    if(s==='opted_in') return '<span class="pill on">opted-in</span>';
    if(s==='blocked') return '<span class="pill bad">blocked</span>';
    return '<span class="pill">unknown</span>';
  }
%>
<h1>Contacts</h1>
<p class="sub">Recipients, their consent, and the lists they belong to. Blocked contacts are never messaged; an inbound “STOP” auto-blocks a contact.</p>

<% if (importSummary) { %>
  <div class="card">
    <div class="alert ok">Imported <%= importSummary.imported %> contact<%= importSummary.imported === 1 ? '' : 's' %> into "<%= importSummary.listName %>".</div>
  </div>
<% } %>

<% if (importPreview) { %>
  <div class="card">
    <h2>Import preview — <%= importPreview.fileName %></h2>
    <p class="sub" style="margin:0 0 12px;">
      <%= importPreview.validCount %> valid row<%= importPreview.validCount === 1 ? '' : 's' %>
      <% if (importPreview.invalidCount) { %>· <%= importPreview.invalidCount %> flagged (invalid or duplicate) — these will be skipped<% } %>
      <% if (!importPreview.hasHeader) { %>· no recognizable header row found, treated column 1 as phone<% } %>
    </p>
    <div class="table-wrap" style="max-height:320px; overflow-y:auto;">
      <table>
        <thead><tr><th>#</th><th>Phone</th><th>Name</th><th>Consent</th><th>Status</th></tr></thead>
        <tbody>
          <% importPreview.rows.forEach(function(r){ %>
            <tr>
              <td class="sub"><%= r.row %></td>
              <td><code><%= r.phone %></code></td>
              <td><%= r.name || '—' %></td>
              <td><%- consentPill(r.consent) %></td>
              <td><% if (r.problem) { %><span class="pill bad"><%= r.problem %></span><% } else { %><span class="pill on">ok</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <form method="post" action="/contacts/import/confirm" class="row" style="align-items:flex-end; margin-top:14px;">
      <input type="hidden" name="rows_json" value="<%= importPreview.rowsJson %>" />
      <input type="hidden" name="file_name" value="<%= importPreview.fileName %>" />
      <div style="flex:1; min-width:220px;">
        <label for="confirm_list_id">Target list</label>
        <select id="confirm_list_id" name="list_id" style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink);">
          <option value="">— choose or type a new one below —</option>
          <% lists.forEach(function(l){ %>
            <option value="<%= l.id %>" <%= importPreview.listId===l.id?'selected':'' %>><%= l.name %> (<%= l.member_count %>)</option>
          <% }); %>
        </select>
      </div>
      <div style="flex:1; min-width:200px;">
        <label for="new_list_name">Or new list name</label>
        <input id="new_list_name" name="new_list_name" type="text" placeholder="e.g. Newsletter Q3" value="<%= importPreview.newListName %>" />
      </div>
      <button type="submit" <%= importPreview.validCount===0?'disabled':'' %>>Import <%= importPreview.validCount %> contact<%= importPreview.validCount === 1 ? '' : 's' %></button>
      <a class="btn secondary" href="/contacts">Cancel</a>
    </form>
  </div>
<% } %>

<div class="card">
  <h2>Lists</h2>
  <p class="sub" style="margin:0 0 12px;">Named segments you can filter by and target with a CSV import.</p>
  <div class="table-wrap" style="margin-bottom:14px;">
    <table>
      <thead><tr><th>Name</th><th>Description</th><th>Members</th></tr></thead>
      <tbody>
        <% if (lists.length === 0) { %>
          <tr><td colspan="3" class="sub">No lists yet — create one below or via CSV import.</td></tr>
        <% } %>
        <% lists.forEach(function(l){ %>
          <tr>
            <td><a href="/contacts?list=<%= l.id %>"><%= l.name %></a></td>
            <td class="muted-note"><%= l.description || '—' %></td>
            <td class="sub"><%= l.member_count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <form method="post" action="/contacts/lists" class="row" style="align-items:flex-end;">
    <div style="flex:1; min-width:200px;">
      <label for="list_name">New list name</label>
      <input id="list_name" name="name" type="text" placeholder="e.g. VIP customers" />
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="list_description">Description (optional)</label>
      <input id="list_description" name="description" type="text" />
    </div>
    <button type="submit">Create list</button>
  </form>
</div>

<div class="card">
  <h2>Import contacts from CSV</h2>
  <p class="sub" style="margin:0 0 12px;">Columns are auto-detected by header name (phone/name/consent). Upload to see a validation preview before anything is saved.</p>
  <form method="post" action="/contacts/import" enctype="multipart/form-data" class="row" style="align-items:flex-end;">
    <div style="flex:1; min-width:220px;">
      <label for="csv_file">CSV file</label>
      <input id="csv_file" name="file" type="file" accept=".csv,text/csv" required />
    </div>
    <button type="submit">Preview import</button>
  </form>
</div>

<div class="card">
  <form method="get" action="/contacts" class="row" style="align-items:flex-end;">
    <div style="flex:1; min-width:200px;">
      <label for="search">Search — phone or name</label>
      <input id="search" name="search" type="text" value="<%= search %>" placeholder="e.g. 15513423891" />
    </div>
    <div style="min-width:160px;">
      <label for="status">Consent</label>
      <select id="status" name="status" style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink); font-size:14px;">
        <option value="" <%= status===''?'selected':'' %>>Any</option>
        <option value="opted_in" <%= status==='opted_in'?'selected':'' %>>Opted-in</option>
        <option value="unknown" <%= status==='unknown'?'selected':'' %>>Unknown</option>
        <option value="blocked" <%= status==='blocked'?'selected':'' %>>Blocked</option>
      </select>
    </div>
    <div style="min-width:180px;">
      <label for="list">List</label>
      <select id="list" name="list" style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink); font-size:14px;">
        <option value="" <%= listFilter===''?'selected':'' %>>Any</option>
        <% lists.forEach(function(l){ %>
          <option value="<%= l.id %>" <%= listFilter===l.id?'selected':'' %>><%= l.name %></option>
        <% }); %>
      </select>
    </div>
    <button type="submit">Search</button>
    <% if (search || status || listFilter) { %><a class="btn secondary" href="/contacts">Clear</a><% } %>
  </form>
</div>

<div class="card">
  <% if (contacts.length === 0) { %>
    <span class="sub">No contacts yet. They appear here once you send to or receive from a number, or import a CSV.</span>
  <% } else { %>
    <table>
      <thead><tr><th>Phone</th><th>Name</th><th>Consent</th><th>Lists</th><th>Last contacted</th><th>Actions</th></tr></thead>
      <tbody>
        <% contacts.forEach(function(c){ %>
          <tr>
            <td><code>+<%= c.phone_number %></code></td>
            <td><%= c.display_name || '—' %></td>
            <td><%- consentPill(c.consent_status) %></td>
            <td>
              <div class="row" style="gap:4px;">
                <% c.lists.forEach(function(l){ %>
                  <form method="post" action="/contacts/<%= c.id %>/lists/<%= l.id %>/remove" style="display:inline;">
                    <button class="pill" type="submit" title="Remove from <%= l.name %>" style="cursor:pointer; border:1px solid var(--line); background:var(--panel-2);"><%= l.name %> ×</button>
                  </form>
                <% }); %>
                <% if (lists.length) { %>
                  <form method="post" action="/contacts/<%= c.id %>/lists" class="row" style="gap:2px;">
                    <select name="list_id" style="padding:4px 6px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--ink); font-size:12px;">
                      <% lists.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %>
                    </select>
                    <button type="submit" class="secondary" style="padding:4px 8px; font-size:12px;">+</button>
                  </form>
                <% } %>
              </div>
            </td>
            <td class="muted-note"><%= c.last_contacted_human %></td>
            <td>
              <div class="row" style="gap:6px;">
                <% if (c.consent_status !== 'opted_in') { %>
                  <form method="post" action="/contacts/<%= c.id %>/consent">
                    <input type="hidden" name="consent_status" value="opted_in" />
                    <button class="secondary" type="submit">Opt-in</button>
                  </form>
                <% } %>
                <% if (c.consent_status !== 'blocked') { %>
                  <form method="post" action="/contacts/<%= c.id %>/consent">
                    <input type="hidden" name="consent_status" value="blocked" />
                    <button class="danger" type="submit">Block</button>
                  </form>
                <% } else { %>
                  <form method="post" action="/contacts/<%= c.id %>/consent">
                    <input type="hidden" name="consent_status" value="unknown" />
                    <button class="secondary" type="submit">Unblock</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('partials/foot') %>
