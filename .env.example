# Copy to .env and adjust as needed. All values are optional — WaGuard boots
# with safe defaults and you set the admin password on first launch in the UI.

# Port the service listens on (host:container mapping is in docker-compose.yml).
PORT=3000

# Signs the admin login cookie. If omitted, a persistent secret is generated
# and stored in the data volume automatically. Set your own (>=32 chars) to
# invalidate all sessions on demand.
# SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Set to true when serving over HTTPS so the session cookie is marked Secure.
# COOKIE_SECURE=false

# Decorative image on the login page. Defaults to a random photo (fresh image
# each page load). Set your own URL, or empty to hide it.
# LOGIN_IMAGE_URL=https://picsum.photos/400/300.jpg

# Display timezone (IANA) for the human-readable *_local timestamps added to API
# responses, webhook payloads, and the dashboard. Stored times stay UTC ISO-8601.
# Defaults to QUIET_TZ, then the server's local timezone.
# APP_TZ=Asia/Kolkata

# --- Milestone 3: anti-ban send pacing (all optional; safe defaults shown) ---
# Randomized human delay between two consecutive sends on the same number (ms).
# SEND_DELAY_MIN_MS=6000
# SEND_DELAY_MAX_MS=25000
# Typing-indicator duration: base + per-character, capped (ms).
# TYPING_BASE_MS=1200
# TYPING_PER_CHAR_MS=45
# TYPING_MAX_MS=9000
# Full daily send ceiling once a number is warmed up.
# DAILY_LIMIT_MAX=250
# Warm-up ramp: daily allowance per day since a number's first send, then the max.
# WARMUP_RAMP=20,40,80,120,160,200
# Quiet hours — no sends in this window; held messages release at the end.
# QUIET_HOURS_ENABLED=true
# QUIET_START_HOUR=21
# QUIET_END_HOUR=8
# QUIET_TZ=America/New_York   # IANA tz; defaults to the server's local time.
# Retry policy for transient send failures.
# SEND_MAX_ATTEMPTS=3
# SEND_RETRY_BACKOFF_MS=30000
# How often the queue worker looks for due messages (ms).
# QUEUE_TICK_MS=2000

# --- Milestone 4: receiving & webhooks (all optional; safe defaults shown) ---
# Public base URL of this service, used to build absolute media-download URLs in
# webhook payloads (inbound media). Set this in production so your receiver can
# fetch media; defaults to http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://wa.example.com
# Webhook delivery: per-request timeout, total attempts before giving up, and the
# exponential backoff base (doubles each retry, capped by WEBHOOK_MAX_BACKOFF_MS).
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_RETRY_BACKOFF_MS=10000
# WEBHOOK_MAX_BACKOFF_MS=3600000
# How often the webhook worker looks for due deliveries (ms).
# WEBHOOK_TICK_MS=1000

# --- Milestone 5: health & consent (all optional; safe defaults shown) ---
# Consent policy for recipients whose consent is "unknown" (never opted-in or
# blocked): "allow" sends to them (default), "block" requires an explicit opt-in
# first. Blocked contacts are ALWAYS rejected regardless of this setting.
# CONSENT_UNKNOWN_POLICY=allow
# Health monitor: trailing window (minutes) over which failures/disconnects are
# judged, and the minimum outbound volume before a failure ratio is trusted.
# HEALTH_WINDOW_MIN=60
# HEALTH_MIN_VOLUME=5
# Failure-ratio thresholds that tip a number to at-risk / flagged.
# HEALTH_ATRISK_RATIO=0.3
# HEALTH_FLAG_RATIO=0.6
# Unexpected disconnects within the window that tip a number to at-risk.
# HEALTH_DISCONNECT_ATRISK=3
# How hard an at-risk number is auto-slowed (delay + daily-limit divisor).
# HEALTH_ATRISK_SLOWDOWN=3
# Cool-off after a flag: base minutes, doubling per repeat offence, capped, with
# the look-back window (minutes) used to count repeats for escalation.
# HEALTH_COOLOFF_BASE_MIN=60
# HEALTH_COOLOFF_MAX_MIN=1440
# HEALTH_COOLOFF_ESCALATE_WINDOW_MIN=10080
